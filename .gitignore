# --- build output ---
build/
*/build/
**/build/
sdkconfig.old
dependencies.lock.bak

# Stray run output: stdout.txt / stderr.txt were committed here by mistake (removed from the index
# 2026-10-07). The publish script also excludes them, so they cannot come back through a sync.
stdout.txt
stderr.txt

# The component manager writes these. Each one records the ABSOLUTE path of the vendored
# components on the machine that generated it (e.g. /Users/<someone>/.../vendor/...), which
# makes a clean clone fail on any other machine with:
#   CMake Error: The "path" field in the manifest file ... does not point to a directory
# (You cannot reproduce it on the machine that generated the file — there the path exists.)
# The build regenerates these in place, so they are not tracked.
# Regression gate: CI step 5 "Portability gate" in .github/workflows/build.yml.
dependencies.lock

# generated per-app sdkconfig copies (the real, tracked ones live in
# components/retro-go/targets/<target>/sdkconfig)
retro-go-p4/*/sdkconfig
retro-go-p4/*/*/sdkconfig

# --- firmware images / backups / archives (never commit these) ---
*.img
dist/
backup/
*.tar.gz

# --- logs ---
logs/
*.log

# --- python ---
__pycache__/
*.pyc

# --- macos ---
.DS_Store

# --- temp ---
*.bak
*.orig
*.rej

# NOTE: vendor/managed_components/ is intentionally tracked — the project's CMake
# lists it in EXTRA_COMPONENT_DIRS, so a clean clone must contain it to build.
partitions.csv
partitions.bin
